<CONFIG>
	<ROOTFOLDER value="/mnt/Applications/Tracks"/>
	<SAMPLELIB value="/mnt/Applications/Samples"/>
	<AUDIOBUFFERSIZE value='512'/>
	<DUMPEVENT value="NO"/>  <!-- YES logs every player tick: debugging only, fills the card -->
	<SCREENMULT value='1'/>  <!-- Don't scale, 240x240 native -->
	<CHANNELMODE value='SPLIT'/>  <!-- SPLIT (default) or PAGED -->
	<KEY_A value="a" />
	<KEY_B value="b" />
	<KEY_LEFT value="l" />
	<KEY_RIGHT value="r" />
	<KEY_DOWN value="d" />
	<KEY_UP value="u" />
	<KEY_LSHOULDER value="m" />
	<KEY_RSHOULDER value="n" />
	<KEY_START value="s" />
	<!-- This RG Nano OS path reports physical FN/Select as KEY_O. -->
	<KEY_SELECT value="o" />
	<KEY_POWER value="q" />
	<KEYDELAY value="200"/>
	<KEYREPEAT value="100" />
	<FONTTYPE  value = '0' />     <!-- '0':original '1':digital '2':monster 'CUSTOM': load custom_font.xml-->
</CONFIG>
