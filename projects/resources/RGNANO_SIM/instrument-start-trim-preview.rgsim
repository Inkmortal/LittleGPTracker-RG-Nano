# Sample trim markers and the preview on the Instrument screen.
route boot.new_project_random
expect_view song
press a 80
wait 100
route song.to_chain
press a 80
wait 100
route chain.to_phrase
press a 80
wait 100
route phrase.to_instrument
expect_view instrument

sim_import_sample_to_instrument 0 wuxia-guzheng.wav
sim_set_sample_trim 0 1200 5200
expect_instrument_sample 0 wuxia-guzheng.wav
expect_screen_text SOURCE
expect_screen_text PREV:ONCE

# A+arrows on the Source row edit the field like upstream; they must not
# change the assigned sample into a trim edit
down a
press d 80
up a
wait 120
expect_instrument_sample 0 wuxia-guzheng.wav
expect_sample_trim_order 0

# LB+Up/Down picks the trim marker
down m
press d 80
up m
wait 80
expect_screen_text EDIT LSTART
down m
press d 80
up m
wait 80
expect_screen_text EDIT END
# LB+A+Left/Right nudges it (1/128 of the sample per step)
down m
down a
press l 80
press l 80
up a
up m
wait 120
expect_sample_trim_order 0
expect_instrument_sample 0 wuxia-guzheng.wav
down m
press d 80
up m
wait 80
expect_screen_text EDIT START
down m
down a
press r 80
press r 80
press r 80
press r 80
up a
up m
wait 120
expect_sample_trim_order 0
expect_instrument_sample 0 wuxia-guzheng.wav

# RB+Start toggles loop-preview mode without starting playback.
down n
press s 80
up n
wait 120
expect_screen_text PREV:LOOP
expect_player_running no
down n
press s 80
up n
wait 120
expect_screen_text PREV:ONCE
expect_player_running no

# RB+A+Up previews the trimmed sample, RB+A+Down stops it
reset_audio_stats
start_audio_capture instrument-start-trim-preview.wav
down n
down a
press u 80
up a
up n
wait 500
expect_player_running yes
expect_play_mode audition
expect_sample_trim_order 0
expect_audio_activity 32
expect_audio_capture_bytes 80000
down n
down a
press d 80
up a
up n
wait 160
expect_player_running no
end_audio_capture
expect_view instrument
expect_no_error
quit
