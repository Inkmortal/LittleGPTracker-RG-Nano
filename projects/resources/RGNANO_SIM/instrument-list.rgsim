# Instrument list (RB+Up on Instrument): browse, hear, name, copy, open.
route boot.new_project_random
expect_view song
press a 80
goto chain
press a 80
goto phrase
press a 80
goto instrument
expect_screen_text RB+Up: all sounds

down n
press u 80
up n
wait 300
expect_screen_text INSTRUMENTS
expect_screen_text 00 SYN KICK
expect_screen_text in 1 phrase
screenshot_app instrument-list.bmp

# Start hears the selected sound, again stops it
press d 80
expect_screen_text 01 SYN
press s 80
wait 400
expect_play_mode audition
expect_audio_activity 32
press s 80
wait 200
expect_player_running no

# Select names it with the keyboard: down lands on J, type JJ, Start = done
press u 80
press k 80
wait 200
expect_screen_text NAME THIS SOUND
press d 80
press a 80
press a 80
press s 80
wait 200
expect_instrument_param 0 name JJ
expect_screen_text 00 SYN JJ

# LB+A copies it into a free slot and moves there
down m
press a 80
up m
wait 200
expect_screen_text 10 SYN JJ
expect_screen_text copy of 00 now in 10
# A opens the copy on the Instrument screen
press a 80
wait 300
expect_view instrument
expect_screen_text JJ
screenshot_app instrument-list-copy.bmp

goto song
expect_no_error
quit
