<CONFIG>
	<ROOTFOLDER value="./rgnano-sim-data/tracks"/>
	<SAMPLELIB value="./rgnano-sim-data/samples"/>
	<AUDIOAPI value="MMSYSTEM"/>
	<AUDIOBUFFERSIZE value="512"/>
	<SCREENMULT value="1"/>
	<CHANNELMODE value="SPLIT"/>
	<DUMPEVENT value="YES"/>
	<KEY_A value="a"/>
	<KEY_B value="b"/>
	<KEY_LEFT value="l"/>
	<KEY_RIGHT value="r"/>
	<KEY_DOWN value="d"/>
	<KEY_UP value="u"/>
	<KEY_LSHOULDER value="m"/>
	<KEY_RSHOULDER value="n"/>
	<KEY_START value="s"/>
	<!-- Match the RG Nano OS: FN/Select sends KEY_K. MENU/Power is separate. -->
	<KEY_SELECT value="k"/>
	<KEY_POWER value="p"/>
	<KEYDELAY value="250"/>  <!-- hold this long before a key repeats -->
	<KEYREPEAT value="66"/>  <!-- then every 66 ms (about 15 per second) -->
	<KEYREPEATFAST value="40"/>  <!-- A + direction held: faster after 6 repeats -->
	<FONTTYPE value="0"/>
</CONFIG>
