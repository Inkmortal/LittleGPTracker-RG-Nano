# Screenshots for the walkthrough: the Dusk demo (loaded via AUTO_LOAD_LAST).
wait 1500
expect_view song
screenshot_app wiki-dusk-song.bmp
# Track 5: the chords
press r 80
press r 80
press r 80
press r 80
goto chain
goto phrase
wait 100
expect_screen_text I07
screenshot_app wiki-dusk-chords.bmp
# Track 6: the hook
goto chain
goto song
press r 80
goto chain
goto phrase
wait 100
expect_screen_text I08
screenshot_app wiki-dusk-hook.bmp
goto chain
goto song
goto fx
wait 200
expect_screen_text CHORUS
screenshot_app wiki-fx.bmp
goto eq
goto limit
set drive 0x3D
set rels 0x80
focus drive
press s 80
wait 2500
screenshot_app wiki-limit.bmp
press s 80
wait 200
goto song
expect_no_error
quit
