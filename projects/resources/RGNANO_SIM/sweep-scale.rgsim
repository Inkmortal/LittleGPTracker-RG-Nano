# Generated by tools/sweep/make_sweep.py from tools/sweep/table.py:
# every key and combo on the scale screen. Don't edit by hand.
wait 1500
soft_fail on

# U: X
case scale__U
sim_reload_project
wait 300
down n
press u 80
up n
wait 150
down n
press r 80
up n
wait 150
wait_stable 2500
expect_view scale
expect_layer none
model_snap
snap before
press u 80
wait 600
state_record noscreen
expect_no_clipping

