# Synth instrument screen, written with goal commands: say what you want
# (goto / page / focus / set / instrument) and the simulator presses
# whatever keys the live screen needs.
route boot.new_project_random
expect_view song
press a 80
goto chain
press a 80
goto phrase
press a 80
expect_phrase_row_count 0 1
goto instrument
expect_screen_text Instrument 00 SYNTH
expect_screen_text KICK
expect_selected_text preset
screenshot_app synth-page-1-sound.bmp

focus wave
# Knob explanations live in the RB+Select helper, not on the page
down n
press k 80
up n
expect_screen_text base tone
down n
press k 80
up n
screenshot_app synth-page-1-wave.bmp
# RB+A+Up previews the sound (Start plays the phrase, as upstream)
down a
press s 80
up a
wait 300
expect_player_running yes
expect_play_mode audition
expect_audio_activity 64
down a
press s 80
up a

page ENV
set decay 0x60
expect_instrument_param 0 decay 0x60
expect_screen_text 32 ms
screenshot_app synth-page-2-env.bmp
page FILTER
set filter lowpass
set cutoff 0x80
expect_instrument_param 0 filter lowpass
expect_instrument_param 0 cutoff 0x80
screenshot_app synth-page-3-filter.bmp
page LFO
screenshot_app synth-page-4-lfo.bmp
page MOD
expect_screen_text 5/7 MOD
screenshot_app synth-page-5-mod.bmp
page MIX
set reverb 0x40
expect_instrument_param 0 reverb 0x40
screenshot_app synth-page-6-mix.bmp

# Other instrument, then switch its engine to sample and back
instrument 01
page SOUND
expect_screen_text SNARE
set type sample
expect_instrument_type 1 Sample
expect_screen_text Instrument 01 SAMPLE
screenshot_app synth-type-sample.bmp
set type synth
expect_instrument_type 1 Synth
set preset bell
expect_instrument_name 1 BELL

down n
press k 80
up n
wait 100
press d 80
expect_screen_text SYNTH SOUND
screenshot_app synth-helper.bmp
down n
press k 80
up n
goto song
expect_no_error
quit
