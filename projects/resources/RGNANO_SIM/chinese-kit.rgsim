# The sound browser lists the group, right after My sounds
press k 80
wait 200
expect_screen_text Chinese instruments
press a 80
wait 300
expect_screen_text chinese
expect_screen_text erhu
expect_screen_text suona
screenshot_app chinese-browser.bmp
press b 80
wait 150
press b 80
wait 200
expect_view rack

# The Chinese modes on the Scale screen (B: the Rack back to the Song)
press b 80
wait 200
expect_view song
sim_set_scale 51
goto scale
wait 150
expect_screen_text Yu (Chinese)
sim_set_scale 47
wait 150
expect_screen_text Gong (Chinese)
expect_no_error
quit
